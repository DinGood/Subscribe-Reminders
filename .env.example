# 订阅提醒站环境变量模板：复制为 .env 后填值
# 飞书三参数可直接填这里，也可在后台「设置→飞书机器人接入」填写（存库优先生效）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 登录鉴权开关（设 0 仅本机建设语境可用，默认 1）
SUB_AUTH_ENABLED=1
# 全新库首次启动的默认管理密码（不进镜像；用户改密后以 DB 为准。设 0/留空=用默认 admin）
SUB_ADMIN_PASSWORD=admin
SUB_PORT=8766
# 监听地址（本机默认 127.0.0.1；Docker 容器内需 0.0.0.0，Dockerfile 已设）
SUB_HOST=127.0.0.1
# 数据目录（默认 站点根/data；Docker 内为 /data 命名卷）
#SUB_DATA_DIR=
# https 反代部署时给会话 cookie 加 Secure 标志（1=开）
#SUB_COOKIE_SECURE=***
# 容器形态日志直上 stdout（1=开，跳过 server.log 轮转文件；Dockerfile 已设）
#SUB_LOG_STDOUT=***
# SMTP 超时秒数（默认 15）
#SUB_SMTP_TIMEOUT=***
