# 订阅提醒站环境变量模板：复制为 .env 后填值
# 飞书三参数可直接填这里，也可在后台「设置→飞书机器人接入」填写（存库优先生效）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 鉴权总闸（设 0=完全免检含 CSRF，仅本机开发后门；默认 1——是否真需登录由页面
# 右上角「后台管理」的库内开关控制，新库默认不勾选=免登录直达，CSRF 双闸两种模式都生效）
SUB_AUTH_ENABLED=1
# 全新库首次启动的默认管理密码（不进镜像；用户改密后以 DB 为准。留空=用默认 admin）
SUB_ADMIN_PASSWORD=admin
SUB_PORT=8766
# 监听地址（本机默认 127.0.0.1；Docker 容器内需 0.0.0.0，Dockerfile 已设）
SUB_HOST=127.0.0.1
# CSRF 受信域名追加（逗号分隔；回环/局域网 IP 恒受信，自定义域名需在此声明）
#SUB_ALLOWED_HOSTS=nas.local,panel.home.lan
# 数据目录（默认 站点根/data；Docker 内为 /data 挂载卷）
#SUB_DATA_DIR=
# https 反代部署时给会话 cookie 加 Secure 标志（1=开）
#SUB_COOKIE_SECURE=1
# 容器形态日志直上 stdout（1=开，跳过 server.log 轮转文件；Dockerfile 已设）
#SUB_LOG_STDOUT=1
# SMTP 超时秒数（默认 15）
#SUB_SMTP_TIMEOUT=15
